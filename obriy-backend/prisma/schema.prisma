// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  STUDENT
  TEACHER
  PARENT
  ADMIN
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum Locale {
  UK @map("uk")
  EN @map("en")
}

enum LessonStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum LessonTaskSubmissionStatus {
  SUBMITTED
  APPROVED
  RETURNED
}

enum AssignmentType {
  WRITTEN
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  MATCHING
  ORDERING
  CATEGORIZATION
  FILL_BLANKS
  IMAGE_HOTSPOT
  MAP_POINT
  MAP_REGION
  MAP_MULTI_REGION
}

enum AssignmentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum AssignmentRevisionStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum AssignmentReleaseStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  CLOSED
  ARCHIVED
}

enum AssignmentScorePolicy {
  BEST
  LATEST
}

enum AssignmentLatePolicy {
  DISALLOW
  ALLOW
  ALLOW_WITH_PENALTY
}

enum AssignmentStudentStatus {
  NOT_STARTED
  IN_PROGRESS
  AWAITING_REVIEW
  NEEDS_REVISION
  COMPLETED
  EXPIRED
}

enum AssignmentAttemptStatus {
  IN_PROGRESS
  AWAITING_REVIEW
  GRADED
  RETURNED
  EXPIRED
  CANCELLED
}

enum AssignmentAttachmentKind {
  PROMPT
  RESPONSE
}

enum AssignmentAttachmentStatus {
  PENDING
  READY
  REJECTED
  DELETED
}

enum AssignmentReviewAction {
  APPROVED
  RETURNED
  SCORE_OVERRIDDEN
  COMMENT_UPDATED
}

enum MapPresetSourceType {
  BUILT_IN
  CUSTOM_GEOJSON
}

enum MapPresetStatus {
  ACTIVE
  ARCHIVED
}

model User {
  id              String     @id @default(uuid())
  email           String     @unique
  passwordHash    String?
  googleId        String?    @unique
  role            UserRole
  status          UserStatus @default(PENDING)
  emailVerifiedAt DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  profile                 Profile?
  refreshTokens           RefreshToken[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  oauthExchangeCodes      OAuthExchangeCode[]
  parentLinks             ParentChild[]            @relation("ParentLinks")
  childLinks              ParentChild[]            @relation("ChildLinks")
  parentInvitations       ParentInvitation[]       @relation("ChildParentInvitations")
  taughtClasses           Class[]                  @relation("TeacherClasses")
  authoredLessons         Lesson[]                 @relation("TeacherLessons")
  lessonTaskSubmissions   LessonTaskSubmission[]   @relation("StudentLessonTaskSubmissions")
  authoredAssignments     Assignment[]             @relation("TeacherAssignments")
  assignmentStates        AssignmentStudentState[] @relation("StudentAssignmentStates")
  reviewedAttempts        AssignmentAttempt[]      @relation("AssignmentAttemptReviewer")
  assignmentReviewEvents  AssignmentReviewEvent[]  @relation("AssignmentReviewEventReviewer")
  assignmentAttachments   AssignmentAttachment[]   @relation("AssignmentAttachmentUploader")
  createdMapPresets       MapPreset[]              @relation("MapPresetCreator")
  studentClassId          String?
  studentClass            Class?                   @relation("ClassStudents", fields: [studentClassId], references: [id], onDelete: SetNull)

  @@index([studentClassId])
}

model OAuthExchangeCode {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model OAuthRegistrationTicket {
  id          String    @id @default(uuid())
  tokenHash   String    @unique
  googleId    String
  email       String
  displayName String
  avatarUrl   String?
  locale      Locale    @default(UK)
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([googleId])
  @@index([email])
  @@index([expiresAt])
}

model Profile {
  id              String   @id @default(uuid())
  userId          String   @unique
  displayName     String
  avatarUrl       String?
  bio             String?
  gradeLevel      Int?
  subjectArea     String?
  preferredLocale Locale   @default(UK)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RefreshToken {
  id                String    @id @default(uuid())
  userId            String
  tokenHash         String    @unique
  expiresAt         DateTime
  revokedAt         DateTime?
  replacedByTokenId String?
  createdAt         DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model EmailVerificationToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model ParentChild {
  parentId  String
  childId   String
  createdAt DateTime @default(now())

  parent User @relation("ParentLinks", fields: [parentId], references: [id], onDelete: Cascade)
  child  User @relation("ChildLinks", fields: [childId], references: [id], onDelete: Cascade)

  @@id([parentId, childId])
  @@index([childId])
}

model ParentInvitation {
  id        String    @id @default(uuid())
  childId   String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  child User @relation("ChildParentInvitations", fields: [childId], references: [id], onDelete: Cascade)

  @@index([childId])
  @@index([expiresAt])
}

model Class {
  id         String   @id @default(uuid())
  teacherId  String
  name       String
  inviteCode String   @unique @db.VarChar(9)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  teacher            User                   @relation("TeacherClasses", fields: [teacherId], references: [id], onDelete: Cascade)
  students           User[]                 @relation("ClassStudents")
  lessonLinks        ClassLesson[]
  taskSubmissions    LessonTaskSubmission[]
  assignmentReleases AssignmentRelease[]

  @@index([teacherId])
}

model Lesson {
  id               String       @id @default(uuid())
  teacherId        String
  title            String       @db.VarChar(160)
  summary          String       @db.VarChar(500)
  content          String       @db.Text
  contentLocale    Locale
  estimatedMinutes Int?
  status           LessonStatus @default(DRAFT)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  teacher            User                @relation("TeacherLessons", fields: [teacherId], references: [id], onDelete: Cascade)
  classLinks         ClassLesson[]
  tasks              LessonTask[]
  assignmentLinks    LessonAssignment[]
  assignmentReleases AssignmentRelease[]

  @@index([teacherId, status, updatedAt])
}

model ClassLesson {
  classId     String
  lessonId    String
  position    Int
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  class  Class  @relation(fields: [classId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@id([classId, lessonId])
  @@index([lessonId])
  @@index([classId, publishedAt, position])
}

model LessonTask {
  id         String   @id @default(uuid())
  lessonId   String
  title      String   @db.VarChar(160)
  prompt     String   @db.Text
  position   Int
  isRequired Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  lesson      Lesson                 @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  submissions LessonTaskSubmission[]

  @@index([lessonId, position])
}

model LessonTaskSubmission {
  id             String                     @id @default(uuid())
  taskId         String
  studentId      String
  classId        String
  answerText     String                     @db.Text
  status         LessonTaskSubmissionStatus @default(SUBMITTED)
  teacherComment String?                    @db.Text
  submittedAt    DateTime                   @default(now())
  reviewedAt     DateTime?
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt

  task    LessonTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  student User       @relation("StudentLessonTaskSubmissions", fields: [studentId], references: [id], onDelete: Cascade)
  class   Class      @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([taskId, studentId, classId])
  @@index([taskId, status])
  @@index([studentId, classId, status])
  @@index([classId, status, submittedAt])
}

model Assignment {
  id                    String           @id @default(uuid())
  teacherId             String
  type                  AssignmentType
  contentLocale         Locale
  status                AssignmentStatus @default(DRAFT)
  defaultMaxPoints      Decimal          @default(1) @db.Decimal(8, 2)
  defaultPassingPercent Decimal          @default(100) @db.Decimal(5, 2)
  archivedAt            DateTime?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  teacher     User                 @relation("TeacherAssignments", fields: [teacherId], references: [id], onDelete: Cascade)
  revisions   AssignmentRevision[]
  lessonLinks LessonAssignment[]
  releases    AssignmentRelease[]

  @@index([teacherId, status, updatedAt])
  @@index([teacherId, type, updatedAt])
}

model AssignmentRevision {
  id            String                   @id @default(uuid())
  assignmentId  String
  mapPresetId   String?
  version       Int
  status        AssignmentRevisionStatus @default(DRAFT)
  title         String                   @db.VarChar(160)
  prompt        String                   @db.Text
  instructions  String?                  @db.Text
  explanation   String?                  @db.Text
  publicConfig  Json
  schemaVersion Int                      @default(1)
  editVersion   Int                      @default(1)
  publishedAt   DateTime?
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt

  assignment  Assignment             @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  mapPreset   MapPreset?             @relation(fields: [mapPresetId], references: [id], onDelete: Restrict)
  solution    AssignmentSolution?
  lessonLinks LessonAssignment[]
  releases    AssignmentRelease[]
  attempts    AssignmentAttempt[]
  attachments AssignmentAttachment[]

  @@unique([assignmentId, version])
  @@unique([id, assignmentId])
  @@index([assignmentId, status, version])
  @@index([mapPresetId])
}

model AssignmentSolution {
  revisionId    String   @id
  gradingConfig Json
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  revision AssignmentRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)
}

model LessonAssignment {
  id           String   @id @default(uuid())
  lessonId     String
  assignmentId String
  revisionId   String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  lesson     Lesson             @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  assignment Assignment         @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  revision   AssignmentRevision @relation(fields: [revisionId, assignmentId], references: [id, assignmentId], onDelete: Restrict)

  @@unique([lessonId, assignmentId])
  @@index([assignmentId])
  @@index([revisionId])
}

model AssignmentRelease {
  id                 String                  @id @default(uuid())
  assignmentId       String
  revisionId         String
  classId            String
  lessonId           String?
  status             AssignmentReleaseStatus @default(DRAFT)
  maxPoints          Decimal                 @db.Decimal(8, 2)
  passingPercent     Decimal                 @default(100) @db.Decimal(5, 2)
  isRequired         Boolean                 @default(true)
  availableFrom      DateTime?
  dueAt              DateTime?
  timeLimitSeconds   Int?
  maxAttempts        Int?
  scorePolicy        AssignmentScorePolicy   @default(BEST)
  latePolicy         AssignmentLatePolicy    @default(DISALLOW)
  latePenaltyPercent Decimal?                @db.Decimal(5, 2)
  xpReward           Int                     @default(0)
  publishedAt        DateTime?
  closedAt           DateTime?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  assignment    Assignment               @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  revision      AssignmentRevision       @relation(fields: [revisionId, assignmentId], references: [id, assignmentId], onDelete: Restrict)
  class         Class                    @relation(fields: [classId], references: [id], onDelete: Cascade)
  lesson        Lesson?                  @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  studentStates AssignmentStudentState[]

  @@index([assignmentId, status, createdAt])
  @@index([revisionId])
  @@index([classId, status, availableFrom, dueAt])
  @@index([lessonId, classId, status])
}

model AssignmentStudentState {
  id             String                  @id @default(uuid())
  releaseId      String
  studentId      String
  status         AssignmentStudentStatus @default(NOT_STARTED)
  attemptCount   Int                     @default(0)
  scorePoints    Decimal?                @db.Decimal(8, 2)
  scorePercent   Decimal?                @db.Decimal(5, 2)
  bestPoints     Decimal?                @db.Decimal(8, 2)
  bestPercent    Decimal?                @db.Decimal(5, 2)
  isLate         Boolean                 @default(false)
  startedAt      DateTime?
  lastActivityAt DateTime?
  submittedAt    DateTime?
  completedAt    DateTime?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  release  AssignmentRelease   @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  student  User                @relation("StudentAssignmentStates", fields: [studentId], references: [id], onDelete: Cascade)
  attempts AssignmentAttempt[]

  @@unique([releaseId, studentId])
  @@index([studentId, status, updatedAt])
  @@index([releaseId, status, completedAt])
}

model AssignmentAttempt {
  id              String                  @id @default(uuid())
  studentStateId  String
  revisionId      String
  reviewedById    String?
  attemptNumber   Int
  clientAttemptId String                  @db.VarChar(64)
  status          AssignmentAttemptStatus @default(IN_PROGRESS)
  responseData    Json?
  gradingData     Json?
  feedbackData    Json?
  maxPoints       Decimal                 @db.Decimal(8, 2)
  scorePoints     Decimal?                @db.Decimal(8, 2)
  scorePercent    Decimal?                @db.Decimal(5, 2)
  isPassed        Boolean?
  isLate          Boolean                 @default(false)
  teacherComment  String?                 @db.Text
  startedAt       DateTime                @default(now())
  expiresAt       DateTime?
  submittedAt     DateTime?
  gradedAt        DateTime?
  reviewedAt      DateTime?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  studentState AssignmentStudentState  @relation(fields: [studentStateId], references: [id], onDelete: Cascade)
  revision     AssignmentRevision      @relation(fields: [revisionId], references: [id], onDelete: Restrict)
  reviewedBy   User?                   @relation("AssignmentAttemptReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  attachments  AssignmentAttachment[]
  reviewEvents AssignmentReviewEvent[]

  @@unique([studentStateId, attemptNumber])
  @@unique([studentStateId, clientAttemptId])
  @@index([revisionId, status])
  @@index([status, submittedAt])
  @@index([reviewedById])
}

model AssignmentAttachment {
  id             String                     @id @default(uuid())
  revisionId     String?
  attemptId      String?
  uploadedById   String?
  kind           AssignmentAttachmentKind
  status         AssignmentAttachmentStatus @default(PENDING)
  storageKey     String                     @unique @db.VarChar(500)
  originalName   String                     @db.VarChar(255)
  mimeType       String                     @db.VarChar(127)
  sizeBytes      BigInt
  checksumSha256 String?                    @db.VarChar(64)
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt

  revision   AssignmentRevision? @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  attempt    AssignmentAttempt?  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  uploadedBy User?               @relation("AssignmentAttachmentUploader", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([revisionId, kind])
  @@index([attemptId, kind])
  @@index([uploadedById])
}

model AssignmentReviewEvent {
  id           String                 @id @default(uuid())
  attemptId    String
  reviewerId   String?
  action       AssignmentReviewAction
  previousData Json?
  nextData     Json?
  comment      String?                @db.Text
  createdAt    DateTime               @default(now())

  attempt  AssignmentAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  reviewer User?             @relation("AssignmentReviewEventReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  @@index([attemptId, createdAt])
  @@index([reviewerId, createdAt])
}

model MapPreset {
  id              String              @id @default(uuid())
  createdById     String?
  key             String              @unique @db.VarChar(120)
  name            String              @db.VarChar(160)
  contentLocale   Locale
  sourceType      MapPresetSourceType
  status          MapPresetStatus     @default(ACTIVE)
  geojsonUrl      String?             @db.VarChar(1000)
  idProperty      String?             @db.VarChar(100)
  year            Int?
  attribution     String              @db.Text
  bounds          Json?
  defaultViewport Json?
  archivedAt      DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  createdBy User?                @relation("MapPresetCreator", fields: [createdById], references: [id], onDelete: SetNull)
  revisions AssignmentRevision[]

  @@index([createdById, status, updatedAt])
  @@index([sourceType, status])
}
