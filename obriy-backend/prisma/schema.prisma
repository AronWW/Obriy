// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  STUDENT
  TEACHER
  PARENT
  ADMIN
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum Locale {
  UK @map("uk")
  EN @map("en")
}

enum LessonStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum AssignmentType {
  WRITTEN
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  MATCHING
  ORDERING
  CATEGORIZATION
  FILL_BLANKS
  IMAGE_HOTSPOT
  MAP_POINT
  MAP_REGION
  MAP_MULTI_REGION
}

enum AssignmentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum AssignmentRevisionStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum AssignmentAttachmentKind {
  PROMPT
  RESPONSE
}

enum AssignmentAttachmentStatus {
  PENDING
  READY
  REJECTED
  DELETED
}

enum TestStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum TestRevisionStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum TestReleaseStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  CLOSED
  ARCHIVED
}

enum TestScorePolicy {
  BEST
  LATEST
}

enum TestLatePolicy {
  DISALLOW
  ALLOW
  ALLOW_WITH_PENALTY
}

enum TestStudentStatus {
  NOT_STARTED
  IN_PROGRESS
  AWAITING_REVIEW
  NEEDS_REVISION
  COMPLETED
  EXPIRED
}

enum TestAttemptStatus {
  IN_PROGRESS
  AWAITING_REVIEW
  GRADED
  RETURNED
  EXPIRED
  CANCELLED
}

enum TestAnswerStatus {
  DRAFT
  AWAITING_REVIEW
  GRADED
  RETURNED
}

enum TestReviewAction {
  APPROVED
  RETURNED
  SCORE_OVERRIDDEN
  COMMENT_UPDATED
}

enum MapPresetSourceType {
  BUILT_IN
  CUSTOM_GEOJSON
}

enum MapPresetStatus {
  ACTIVE
  ARCHIVED
}

enum MapPresetBaseMapMode {
  STANDARD
  NEUTRAL
}

enum XPSourceType {
  TEST_RELEASE_PASS
}

enum BadgeCriteriaType {
  PASSED_TEST_COUNT
  PERFECT_SCORE_COUNT
}

enum NotificationType {
  TEST_ASSIGNED
  TEST_AVAILABLE
  TEST_DUE_SOON
  TEST_OVERDUE
  TEST_REVIEW_REQUIRED
  TEST_GRADED
  TEST_NEEDS_REVISION
  BADGE_UNLOCKED
  LEVEL_UP
  CHAT_MESSAGE
  LESSON_MODERATION_CHANGES_REQUESTED
  LESSON_MODERATION_APPROVED
  LESSON_MODERATION_REMOVED
  LESSON_REPORT_RESOLVED
}

enum ChatAttachmentResourceType {
  IMAGE
  RAW
}

enum LessonModerationStatus {
  CLEAR
  UNDER_REVIEW
  CHANGES_REQUESTED
  REMOVED
}

enum LessonModerationCaseStatus {
  REPORTED
  UNDER_REVIEW
  CHANGES_REQUESTED
  APPROVED
  DISMISSED
  REMOVED
}

enum LessonReportCategory {
  AGE_INAPPROPRIATE
  VIOLENCE
  HATE_OR_HARASSMENT
  SEXUAL_CONTENT
  PERSONAL_DATA
  MISINFORMATION
  OTHER
}

enum AdminAuditAction {
  USER_SUSPENDED
  USER_RESTORED
  SUSPENSION_APPEAL_APPROVED
  SUSPENSION_APPEAL_REJECTED
  LESSON_HIDDEN
  LESSON_REPORT_DISMISSED
  LESSON_CHANGES_REQUESTED
  LESSON_APPROVED
  LESSON_REMOVED
}

enum AdminAuditTargetType {
  USER
  SUSPENSION_APPEAL
  LESSON
  MODERATION_CASE
}

enum SuspensionAppealStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id              String     @id @default(uuid())
  email           String     @unique
  passwordHash    String?
  googleId        String?    @unique
  role            UserRole
  status          UserStatus @default(PENDING)
  sessionVersion  Int        @default(0)
  emailVerifiedAt DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  profile                 Profile?
  refreshTokens           RefreshToken[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  oauthExchangeCodes      OAuthExchangeCode[]
  parentLinks             ParentChild[]            @relation("ParentLinks")
  childLinks              ParentChild[]            @relation("ChildLinks")
  parentInvitations       ParentInvitation[]       @relation("ChildParentInvitations")
  taughtClasses           Class[]                  @relation("TeacherClasses")
  authoredLessons         Lesson[]                 @relation("TeacherLessons")
  authoredAssignments     Assignment[]             @relation("TeacherAssignments")
  assignmentAttachments   AssignmentAttachment[]   @relation("AssignmentAttachmentUploader")
  createdMapPresets       MapPreset[]              @relation("MapPresetCreator")
  mapDrafts               MapDraft[]               @relation("MapDraftTeacher")
  authoredTests           Test[]                   @relation("TeacherTests")
  testStates              TestStudentState[]       @relation("StudentTestStates")
  reviewedTestAnswers     TestAnswer[]             @relation("TestAnswerReviewer")
  testAnswerReviewEvents  TestAnswerReviewEvent[]  @relation("TestAnswerReviewEventReviewer")
  xpLedger                XPLedger[]               @relation("StudentXPLedger")
  earnedBadges            UserBadge[]              @relation("StudentBadges")
  receivedNotifications   Notification[]           @relation("NotificationRecipient")
  subjectNotifications    Notification[]           @relation("NotificationSubjectStudent")
  taughtConversations     Conversation[]           @relation("ConversationTeacher")
  studentConversations    Conversation[]           @relation("ConversationStudent")
  sentMessages            Message[]                @relation("MessageSender")
  submittedLessonReports  LessonReport[]           @relation("LessonReportReporter")
  subjectLessonReports    LessonReport[]           @relation("LessonReportSubjectStudent")
  reviewedModerationCases LessonModerationCase[]   @relation("LessonModerationReviewer")
  adminAuditLogs          AdminAuditLog[]          @relation("AdminAuditActor")
  suspensionAppeals       SuspensionAppeal[]       @relation("SuspensionAppealUser")
  reviewedAppeals         SuspensionAppeal[]       @relation("SuspensionAppealReviewer")
  studentClassId          String?
  studentClass            Class?                   @relation("ClassStudents", fields: [studentClassId], references: [id], onDelete: SetNull)

  @@index([studentClassId])
}

model OAuthExchangeCode {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model OAuthRegistrationTicket {
  id          String    @id @default(uuid())
  tokenHash   String    @unique
  googleId    String
  email       String
  displayName String
  avatarUrl   String?
  locale      Locale    @default(UK)
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([googleId])
  @@index([email])
  @@index([expiresAt])
}

model Profile {
  id               String   @id @default(uuid())
  userId           String   @unique
  displayName      String
  avatarUrl        String?
  avatarStorageKey String?  @db.VarChar(255)
  bio              String?
  subjectArea      String?
  preferredLocale  Locale   @default(UK)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RefreshToken {
  id                String    @id @default(uuid())
  userId            String
  tokenHash         String    @unique
  expiresAt         DateTime
  revokedAt         DateTime?
  replacedByTokenId String?
  createdAt         DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model EmailVerificationToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model ParentChild {
  parentId  String
  childId   String
  createdAt DateTime @default(now())

  parent User @relation("ParentLinks", fields: [parentId], references: [id], onDelete: Cascade)
  child  User @relation("ChildLinks", fields: [childId], references: [id], onDelete: Cascade)

  @@id([parentId, childId])
  @@index([childId])
}

model ParentInvitation {
  id        String    @id @default(uuid())
  childId   String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  child User @relation("ChildParentInvitations", fields: [childId], references: [id], onDelete: Cascade)

  @@index([childId])
  @@index([expiresAt])
}

model Class {
  id         String   @id @default(uuid())
  teacherId  String
  name       String
  inviteCode String   @unique @db.VarChar(9)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  teacher       User           @relation("TeacherClasses", fields: [teacherId], references: [id], onDelete: Cascade)
  students      User[]         @relation("ClassStudents")
  lessonLinks   ClassLesson[]
  testReleases  TestRelease[]
  lessonReports LessonReport[]

  @@index([teacherId])
}

model Lesson {
  id               String                 @id @default(uuid())
  teacherId        String
  title            String                 @db.VarChar(160)
  summary          String                 @db.VarChar(500)
  content          String                 @db.Text
  contentLocale    Locale
  estimatedMinutes Int?
  status           LessonStatus           @default(DRAFT)
  moderationStatus LessonModerationStatus @default(CLEAR)
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  teacher         User                   @relation("TeacherLessons", fields: [teacherId], references: [id], onDelete: Cascade)
  classLinks      ClassLesson[]
  testLinks       LessonTest[]
  testReleases    TestRelease[]
  moderationCases LessonModerationCase[]

  @@index([teacherId, status, updatedAt])
  @@index([moderationStatus, updatedAt])
}

model LessonModerationCase {
  id              String                     @id @default(uuid())
  lessonId        String
  status          LessonModerationCaseStatus @default(REPORTED)
  initialSnapshot Json
  resolutionNote  String?                    @db.Text
  reviewedById    String?
  editVersion     Int                        @default(1)
  resolvedAt      DateTime?
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt

  lesson     Lesson         @relation(fields: [lessonId], references: [id], onDelete: Restrict)
  reviewedBy User?          @relation("LessonModerationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reports    LessonReport[]

  @@index([status, createdAt, id])
  @@index([lessonId, createdAt])
  @@index([reviewedById, updatedAt])
}

model LessonReport {
  id               String               @id @default(uuid())
  caseId           String
  reporterId       String
  subjectStudentId String
  classId          String
  category         LessonReportCategory
  details          String               @db.Text
  createdAt        DateTime             @default(now())

  moderationCase LessonModerationCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  reporter       User                 @relation("LessonReportReporter", fields: [reporterId], references: [id], onDelete: Restrict)
  subjectStudent User                 @relation("LessonReportSubjectStudent", fields: [subjectStudentId], references: [id], onDelete: Restrict)
  class          Class                @relation(fields: [classId], references: [id], onDelete: Restrict)

  @@unique([caseId, reporterId])
  @@index([reporterId, createdAt])
  @@index([subjectStudentId, createdAt])
  @@index([classId, createdAt])
}

model AdminAuditLog {
  id         String               @id @default(uuid())
  actorId    String
  action     AdminAuditAction
  targetType AdminAuditTargetType
  targetId   String               @db.VarChar(64)
  reason     String               @db.VarChar(500)
  metadata   Json?
  createdAt  DateTime             @default(now())

  actor                    User               @relation("AdminAuditActor", fields: [actorId], references: [id], onDelete: Restrict)
  sourceSuspensionAppeals  SuspensionAppeal[] @relation("SuspensionAppealSourceAudit")

  @@index([actorId, createdAt, id])
  @@index([action, createdAt, id])
  @@index([targetType, targetId, createdAt])
}

model SuspensionAppeal {
  id                   String                 @id @default(uuid())
  userId               String
  suspensionAuditLogId String
  status               SuspensionAppealStatus @default(PENDING)
  message              String                 @db.Text
  resolutionNote       String?                @db.Text
  reviewedById         String?
  reviewedAt           DateTime?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  user               User          @relation("SuspensionAppealUser", fields: [userId], references: [id], onDelete: Cascade)
  suspensionAuditLog AdminAuditLog @relation("SuspensionAppealSourceAudit", fields: [suspensionAuditLogId], references: [id], onDelete: Restrict)
  reviewedBy         User?         @relation("SuspensionAppealReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([userId, createdAt, id])
  @@index([suspensionAuditLogId, createdAt])
  @@index([status, createdAt, id])
  @@index([reviewedById, reviewedAt])
}

model ClassLesson {
  classId     String
  lessonId    String
  position    Int
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  class  Class  @relation(fields: [classId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@id([classId, lessonId])
  @@index([lessonId])
  @@index([classId, publishedAt, position])
}

model Assignment {
  id                    String           @id @default(uuid())
  teacherId             String
  type                  AssignmentType
  contentLocale         Locale
  status                AssignmentStatus @default(DRAFT)
  defaultMaxPoints      Decimal          @default(1) @db.Decimal(8, 2)
  defaultPassingPercent Decimal          @default(100) @db.Decimal(5, 2)
  archivedAt            DateTime?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  teacher   User                 @relation("TeacherAssignments", fields: [teacherId], references: [id], onDelete: Cascade)
  revisions AssignmentRevision[]
  testItems TestItem[]

  @@index([teacherId, status, updatedAt])
  @@index([teacherId, type, updatedAt])
}

model AssignmentRevision {
  id            String                   @id @default(uuid())
  assignmentId  String
  mapPresetId   String?
  version       Int
  status        AssignmentRevisionStatus @default(DRAFT)
  title         String                   @db.VarChar(160)
  prompt        String                   @db.Text
  instructions  String?                  @db.Text
  explanation   String?                  @db.Text
  publicConfig  Json
  schemaVersion Int                      @default(1)
  editVersion   Int                      @default(1)
  publishedAt   DateTime?
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt

  assignment  Assignment                     @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  mapPreset   MapPreset?                     @relation(fields: [mapPresetId], references: [id], onDelete: Restrict)
  solution    AssignmentSolution?
  promptImage AssignmentRevisionPromptImage?
  testItems   TestItem[]

  @@unique([assignmentId, version])
  @@unique([id, assignmentId])
  @@index([assignmentId, status, version])
  @@index([mapPresetId])
}

model AssignmentSolution {
  revisionId    String   @id
  gradingConfig Json
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  revision AssignmentRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)
}

model AssignmentAttachment {
  id             String                     @id @default(uuid())
  testAnswerId   String?
  uploadedById   String?
  kind           AssignmentAttachmentKind
  status         AssignmentAttachmentStatus @default(PENDING)
  storageKey     String                     @unique @db.VarChar(500)
  originalName   String                     @db.VarChar(255)
  mimeType       String                     @db.VarChar(127)
  sizeBytes      BigInt
  checksumSha256 String?                    @db.VarChar(64)
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt

  revisionLinks AssignmentRevisionPromptImage[]
  testAnswer    TestAnswer?                     @relation(fields: [testAnswerId], references: [id], onDelete: Cascade)
  uploadedBy    User?                           @relation("AssignmentAttachmentUploader", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([testAnswerId, kind])
  @@index([uploadedById])
}

model AssignmentRevisionPromptImage {
  revisionId   String   @id
  attachmentId String
  createdAt    DateTime @default(now())

  revision   AssignmentRevision   @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  attachment AssignmentAttachment @relation(fields: [attachmentId], references: [id], onDelete: Restrict)

  @@index([attachmentId])
}

model Test {
  id            String     @id @default(uuid())
  teacherId     String
  contentLocale Locale
  status        TestStatus @default(DRAFT)
  archivedAt    DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  teacher     User           @relation("TeacherTests", fields: [teacherId], references: [id], onDelete: Cascade)
  revisions   TestRevision[]
  lessonLinks LessonTest[]
  releases    TestRelease[]

  @@index([teacherId, status, updatedAt])
  @@index([teacherId, updatedAt])
}

model TestRevision {
  id               String             @id @default(uuid())
  testId           String
  version          Int
  status           TestRevisionStatus @default(DRAFT)
  title            String             @db.VarChar(160)
  description      String             @db.VarChar(500)
  instructions     String?            @db.Text
  passingPercent   Decimal            @default(100) @db.Decimal(5, 2)
  maxAttempts      Int?               @default(1)
  timeLimitSeconds Int?
  scorePolicy      TestScorePolicy    @default(BEST)
  shuffleItems     Boolean            @default(false)
  schemaVersion    Int                @default(1)
  editVersion      Int                @default(1)
  publishedAt      DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  test        Test          @relation(fields: [testId], references: [id], onDelete: Cascade)
  items       TestItem[]
  lessonLinks LessonTest[]
  releases    TestRelease[]
  attempts    TestAttempt[]

  @@unique([testId, version])
  @@unique([id, testId])
  @@index([testId, status, version])
}

model TestItem {
  id                   String   @id @default(uuid())
  testRevisionId       String
  assignmentId         String
  assignmentRevisionId String
  position             Int
  maxPoints            Decimal  @db.Decimal(8, 2)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  testRevision       TestRevision       @relation(fields: [testRevisionId], references: [id], onDelete: Cascade)
  assignment         Assignment         @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  assignmentRevision AssignmentRevision @relation(fields: [assignmentRevisionId, assignmentId], references: [id, assignmentId], onDelete: Restrict)
  answers            TestAnswer[]

  @@unique([testRevisionId, position])
  @@unique([testRevisionId, assignmentId])
  @@unique([id, testRevisionId])
  @@index([assignmentId])
  @@index([assignmentRevisionId])
}

model LessonTest {
  id             String   @id @default(uuid())
  lessonId       String
  testId         String
  testRevisionId String
  position       Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  lesson   Lesson       @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  test     Test         @relation(fields: [testId], references: [id], onDelete: Cascade)
  revision TestRevision @relation(fields: [testRevisionId, testId], references: [id, testId], onDelete: Restrict)

  @@unique([lessonId, testId])
  @@index([lessonId, position])
  @@index([testId])
  @@index([testRevisionId])
}

model TestRelease {
  id                 String            @id @default(uuid())
  testId             String
  testRevisionId     String
  classId            String
  lessonId           String?
  status             TestReleaseStatus @default(DRAFT)
  maxPoints          Decimal           @db.Decimal(8, 2)
  passingPercent     Decimal           @default(100) @db.Decimal(5, 2)
  isRequired         Boolean           @default(true)
  availableFrom      DateTime?
  dueAt              DateTime?
  timeLimitSeconds   Int?
  maxAttempts        Int?
  scorePolicy        TestScorePolicy   @default(BEST)
  latePolicy         TestLatePolicy    @default(DISALLOW)
  latePenaltyPercent Decimal?          @db.Decimal(5, 2)
  xpReward           Int               @default(0)
  publishedAt        DateTime?
  closedAt           DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  test          Test               @relation(fields: [testId], references: [id], onDelete: Restrict)
  revision      TestRevision       @relation(fields: [testRevisionId, testId], references: [id, testId], onDelete: Restrict)
  class         Class              @relation(fields: [classId], references: [id], onDelete: Cascade)
  lesson        Lesson?            @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  studentStates TestStudentState[]
  xpLedger      XPLedger[]

  @@index([testId, status, createdAt])
  @@index([testRevisionId])
  @@index([classId, status, availableFrom, dueAt])
  @@index([lessonId, classId, status])
}

model TestStudentState {
  id             String            @id @default(uuid())
  releaseId      String
  studentId      String
  status         TestStudentStatus @default(NOT_STARTED)
  attemptCount   Int               @default(0)
  scorePoints    Decimal?          @db.Decimal(8, 2)
  scorePercent   Decimal?          @db.Decimal(5, 2)
  bestPoints     Decimal?          @db.Decimal(8, 2)
  bestPercent    Decimal?          @db.Decimal(5, 2)
  isLate         Boolean           @default(false)
  startedAt      DateTime?
  lastActivityAt DateTime?
  submittedAt    DateTime?
  completedAt    DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  release  TestRelease   @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  student  User          @relation("StudentTestStates", fields: [studentId], references: [id], onDelete: Cascade)
  attempts TestAttempt[]

  @@unique([releaseId, studentId])
  @@index([studentId, status, updatedAt])
  @@index([releaseId, status, completedAt])
}

model TestAttempt {
  id                 String            @id @default(uuid())
  studentStateId     String
  testRevisionId     String
  attemptNumber      Int
  clientAttemptId    String            @db.VarChar(64)
  status             TestAttemptStatus @default(IN_PROGRESS)
  maxPoints          Decimal           @db.Decimal(8, 2)
  scorePoints        Decimal?          @db.Decimal(8, 2)
  scorePercent       Decimal?          @db.Decimal(5, 2)
  isPassed           Boolean?
  pendingReviewCount Int               @default(0)
  isLate             Boolean           @default(false)
  startedAt          DateTime          @default(now())
  expiresAt          DateTime?
  submittedAt        DateTime?
  gradedAt           DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  studentState TestStudentState @relation(fields: [studentStateId], references: [id], onDelete: Cascade)
  testRevision TestRevision     @relation(fields: [testRevisionId], references: [id], onDelete: Restrict)
  answers      TestAnswer[]
  xpLedger     XPLedger[]
  badgeUnlocks UserBadge[]      @relation("BadgeUnlockAttempt")

  @@unique([studentStateId, attemptNumber])
  @@unique([studentStateId, clientAttemptId])
  @@unique([id, testRevisionId])
  @@index([testRevisionId, status])
  @@index([status, submittedAt])
}

model XPLedger {
  id            String       @id @default(uuid())
  studentId     String
  sourceType    XPSourceType
  sourceKey     String       @db.VarChar(160)
  releaseId     String?
  attemptId     String?
  amount        Int
  totalXpBefore Int
  totalXpAfter  Int
  seenAt        DateTime?
  createdAt     DateTime     @default(now())

  student User         @relation("StudentXPLedger", fields: [studentId], references: [id], onDelete: Cascade)
  release TestRelease? @relation(fields: [releaseId], references: [id], onDelete: SetNull)
  attempt TestAttempt? @relation(fields: [attemptId], references: [id], onDelete: SetNull)

  @@unique([studentId, sourceType, sourceKey])
  @@index([studentId, createdAt])
  @@index([studentId, seenAt])
  @@index([releaseId])
  @@index([attemptId])
}

model Badge {
  id            String            @id @default(uuid())
  key           String            @unique @db.VarChar(80)
  iconKey       String            @db.VarChar(80)
  criteriaType  BadgeCriteriaType
  criteriaValue Int
  isActive      Boolean           @default(true)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  translations BadgeTranslation[]
  awards       UserBadge[]

  @@index([isActive, criteriaType])
}

model BadgeTranslation {
  id          String @id @default(uuid())
  badgeId     String
  locale      Locale
  name        String @db.VarChar(120)
  description String @db.VarChar(300)

  badge Badge @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([badgeId, locale])
  @@index([locale])
}

model UserBadge {
  id               String    @id @default(uuid())
  studentId        String
  badgeId          String
  sourceAttemptId  String?
  showcasePosition Int?
  seenAt           DateTime?
  earnedAt         DateTime  @default(now())

  student       User         @relation("StudentBadges", fields: [studentId], references: [id], onDelete: Cascade)
  badge         Badge        @relation(fields: [badgeId], references: [id], onDelete: Restrict)
  sourceAttempt TestAttempt? @relation("BadgeUnlockAttempt", fields: [sourceAttemptId], references: [id], onDelete: SetNull)

  @@unique([studentId, badgeId])
  @@unique([studentId, showcasePosition])
  @@index([studentId, earnedAt])
  @@index([studentId, seenAt])
  @@index([badgeId])
  @@index([sourceAttemptId])
}

model Notification {
  id               String           @id @default(uuid())
  recipientId      String
  subjectStudentId String?
  type             NotificationType
  payload          Json
  deduplicationKey String           @db.VarChar(180)
  readAt           DateTime?
  createdAt        DateTime         @default(now())

  recipient      User  @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  subjectStudent User? @relation("NotificationSubjectStudent", fields: [subjectStudentId], references: [id], onDelete: SetNull)

  @@unique([recipientId, deduplicationKey])
  @@index([recipientId, readAt, createdAt])
  @@index([recipientId, createdAt, id])
  @@index([subjectStudentId])
}

model Conversation {
  id                String    @id @default(uuid())
  teacherId         String
  studentId         String
  teacherLastReadAt DateTime?
  studentLastReadAt DateTime?
  lastMessageAt     DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  teacher  User      @relation("ConversationTeacher", fields: [teacherId], references: [id], onDelete: Cascade)
  student  User      @relation("ConversationStudent", fields: [studentId], references: [id], onDelete: Cascade)
  messages Message[]

  @@unique([teacherId, studentId])
  @@index([teacherId, lastMessageAt, id])
  @@index([studentId, lastMessageAt, id])
}

model Message {
  id              String    @id @default(uuid())
  conversationId  String
  senderId        String
  clientMessageId String    @db.VarChar(36)
  body            String?   @db.Text
  editedAt        DateTime?
  createdAt       DateTime  @default(now())

  conversation Conversation        @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User                @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  attachments  MessageAttachment[]

  @@unique([senderId, clientMessageId])
  @@index([conversationId, createdAt, id])
  @@index([senderId])
}

model MessageAttachment {
  id               String                     @id @default(uuid())
  messageId        String
  storageKey       String                     @db.VarChar(255)
  resourceType     ChatAttachmentResourceType
  originalFileName String                     @db.VarChar(255)
  mimeType         String                     @db.VarChar(120)
  sizeBytes        Int
  createdAt        DateTime                   @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
}

model TestAnswer {
  id             String           @id @default(uuid())
  testAttemptId  String
  testRevisionId String
  testItemId     String
  reviewedById   String?
  status         TestAnswerStatus @default(DRAFT)
  responseData   Json?
  gradingData    Json?
  feedbackData   Json?
  maxPoints      Decimal          @db.Decimal(8, 2)
  scorePoints    Decimal?         @db.Decimal(8, 2)
  scorePercent   Decimal?         @db.Decimal(5, 2)
  isCorrect      Boolean?
  teacherComment String?          @db.Text
  gradedAt       DateTime?
  reviewedAt     DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  testAttempt  TestAttempt             @relation(fields: [testAttemptId, testRevisionId], references: [id, testRevisionId], onDelete: Cascade)
  testItem     TestItem                @relation(fields: [testItemId, testRevisionId], references: [id, testRevisionId], onDelete: Restrict)
  reviewedBy   User?                   @relation("TestAnswerReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewEvents TestAnswerReviewEvent[]
  attachments  AssignmentAttachment[]

  @@unique([testAttemptId, testItemId])
  @@index([testItemId, status])
  @@index([status, reviewedAt])
  @@index([reviewedById])
}

model TestAnswerReviewEvent {
  id           String           @id @default(uuid())
  testAnswerId String
  reviewerId   String?
  action       TestReviewAction
  previousData Json?
  nextData     Json?
  comment      String?          @db.Text
  createdAt    DateTime         @default(now())

  testAnswer TestAnswer @relation(fields: [testAnswerId], references: [id], onDelete: Cascade)
  reviewer   User?      @relation("TestAnswerReviewEventReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  @@index([testAnswerId, createdAt])
  @@index([reviewerId, createdAt])
}

model MapPreset {
  id               String               @id @default(uuid())
  createdById      String?
  key              String               @unique @db.VarChar(120)
  name             String               @db.VarChar(160)
  contentLocale    Locale
  sourceType       MapPresetSourceType
  status           MapPresetStatus      @default(ACTIVE)
  baseMapMode      MapPresetBaseMapMode @default(STANDARD)
  geojsonUrl       String?              @db.VarChar(1000)
  storageKey       String?              @unique @db.VarChar(500)
  originalFileName String?              @db.VarChar(255)
  fileSizeBytes    Int?
  featureCount     Int?
  vertexCount      Int?
  idProperty       String?              @db.VarChar(100)
  year             Int?
  periodLabel      String?              @db.VarChar(120)
  attribution      String               @db.Text
  bounds           Json?
  defaultViewport  Json?
  archivedAt       DateTime?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  createdBy   User?                @relation("MapPresetCreator", fields: [createdById], references: [id], onDelete: SetNull)
  revisions   AssignmentRevision[]
  draftCopies MapDraft[]           @relation("MapDraftSourcePreset")

  @@index([createdById, status, updatedAt])
  @@index([sourceType, status])
}

model MapDraft {
  id               String   @id @default(uuid())
  teacherId        String
  sourcePresetId   String?
  name             String   @db.VarChar(160)
  contentLocale    Locale
  periodLabel      String?  @db.VarChar(120)
  attribution      String   @default("") @db.Text
  storageKey       String?  @unique @db.VarChar(500)
  originalFileName String?  @db.VarChar(255)
  fileSizeBytes    Int?
  featureCount     Int      @default(0)
  vertexCount      Int      @default(0)
  bounds           Json?
  defaultViewport  Json?
  editVersion      Int      @default(1)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  teacher      User       @relation("MapDraftTeacher", fields: [teacherId], references: [id], onDelete: Cascade)
  sourcePreset MapPreset? @relation("MapDraftSourcePreset", fields: [sourcePresetId], references: [id], onDelete: SetNull)

  @@index([teacherId, updatedAt])
  @@index([sourcePresetId])
}
