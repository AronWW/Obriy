NODE_ENV=development
API_PUBLIC_URL=http://localhost:3000
DATABASE_URL=postgresql://obriy:obriy_password@127.0.0.1:5433/obriy_db?schema=public
TEST_DATABASE_URL=postgresql://obriy:obriy_password@127.0.0.1:5433/obriy_test?schema=public
DATABASE_SSL=false
DATABASE_POOL_MAX=5
PORT=3000
FRONTEND_URL=http://localhost:5173

JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
REFRESH_TOKEN_COOKIE_NAME=obriy_refresh_token
COOKIE_SAME_SITE=lax
COOKIE_SECURE=false
# Leave empty in production so the refresh cookie remains host-only.
COOKIE_DOMAIN=

EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=30
EMAIL_SEND_COOLDOWN_SECONDS=60

RESEND_API_KEY=
MAIL_FROM=Obriy <onboarding@resend.dev>

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback
GOOGLE_OAUTH_STATE_SECRET=replace-with-a-separate-random-secret
OAUTH_EXCHANGE_TTL_SECONDS=60
OAUTH_REGISTRATION_TTL_MINUTES=10

AUTH_TRANSIENT_TOKEN_RETENTION_DAYS=7
OAUTH_CODE_RETENTION_DAYS=1
REFRESH_TOKEN_RETENTION_DAYS=30

ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_DISPLAY_NAME=Obriy Admin

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_AVATAR_FOLDER=obriy/dev
